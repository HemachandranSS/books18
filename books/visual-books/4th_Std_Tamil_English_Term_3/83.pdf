            <rdf:Alt>
               <rdf:li xml:lang="x-default">Colorful beach ball set</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Colorful beach ball set. Inflatable balls for outdoor games. Can be used for topics like recreation, activity, fitness</rdf:li>
